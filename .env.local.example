# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Password for /admin. At least 12 characters, or admin login stays disabled.
ADMIN_PASSWORD=

# Neon Postgres connection string (postgresql://...). Leave empty locally to save
# leads to data/leads.json instead. Required on Vercel.
DATABASE_URL=

# Full public address of the site, e.g. https://kestrel-site.vercel.app
# Used for the sitemap, canonical links and link previews. Set it on Vercel.
NEXT_PUBLIC_SITE_URL=
